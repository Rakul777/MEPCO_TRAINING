   "source": [
    "# =========================\n",
    "# 3. API SETUP\n",
    "# =========================\n",
    "\n",
    "api_key = os.environ.get(\"GROQ_API_KEY\")\n",
    "\n",
    "if not api_key:\n",
    "    api_key = getpass(\"Enter your NEW Groq API key: \")\n",
    "\n",
    "if not api_key.strip():\n",
    "    raise RuntimeError(\"No API key was provided.\")\n",
    "\n",
    "os.environ[\"GROQ_API_KEY\"] = api_key.strip()\n",
    "\n",
    "client = Groq(\n",
    "    api_key=api_key.strip(),\n",
    "    timeout=60.0,\n",
    "    max_retries=2\n",
    ")\n",
    "\n",
    "print(\"✓ Groq client initialized.\")\n"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 4. Model Selection Module\n",
    "\n",
    "The notebook first checks whether the preferred model is available. If it is not, it automatically selects an available text-generation model instead of repeatedly failing on an unavailable model."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 4,
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "✓ Selected model: openai/gpt-oss-120b\n"
     ]
    }
   ],
   "source": [
    "# =========================\n",
    "# 4. MODEL SELECTION\n",
    "# =========================\n",
    "\n",
    "def select_model(client, preferred_model):\n",
    "    try:\n",
    "        models = client.models.list()\n",
    "        model_ids = [m.id for m in models.data]\n",
    "\n",
    "        if preferred_model in model_ids:\n",
    "            print(f\"✓ Selected model: {preferred_model}\")\n",
    "            return preferred_model\n",
    "\n",
    "        # Prefer common large/open models if the preferred model is unavailable.\n",
    "        preferred_fallbacks = [\n",
    "            \"openai/gpt-oss-120b\",\n",
    "            \"openai/gpt-oss-20b\",\n",
    "            \"llama-3.3-70b-versatile\",\n",
    "            \"llama-3.1-70b-versatile\",\n",
    "        ]\n",
    "\n",
    "        for candidate in preferred_fallbacks:\n",
    "            if candidate in model_ids:\n",
    "                print(f\"⚠ Preferred model unavailable. Using: {candidate}\")\n",
    "                return candidate\n",
    "\n",
    "        # Last resort: choose an available model whose name suggests text generation.\n",
    "        blocked = (\"whisper\", \"guard\", \"safeguard\", \"tts\", \"speech\", \"vision\")\n",
    "        candidates = [\n",
    "            mid for mid in model_ids\n",
    "            if not any(word in mid.lower() for word in blocked)\n",
    "        ]\n",
    "\n",
    "        if candidates:\n",
    "            print(f\"⚠ Preferred model unavailable. Using available model: {candidates[0]}\")\n",
    "            return candidates[0]\n",
    "\n",
    "        raise RuntimeError(\"No suitable text-generation model was found.\")\n",
    "\n",
    "    except Exception as e:\n",
    "        raise RuntimeError(\n",
    "            \"Could not access the Groq model list. \"\n",
    "            f\"Check the API key/network connection. Details: {type(e).__name__}: {e}\"\n",
    "        )\n",
    "\n",
    "GROQ_MODEL = select_model(client, PREFERRED_MODEL)\n"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 5. PDF Text Extraction Module"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 5,
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "============================================================\n",
      "[1/7] PDF EXTRACTION\n",
      "============================================================\n",
      "✓ Pages extracted : 20\n",
      "✓ Characters      : 57,005\n"
     ]
    }
   ],
   "source": [
    "# =========================\n",
    "# 5. PDF EXTRACTION\n",
    "# =========================\n",
    "\n",
    "def extract_pdf_text(pdf_path):\n",
    "    if not Path(pdf_path).exists():\n",
    "        raise FileNotFoundError(f\"PDF not found: {pdf_path}\")\n",
    "\n",
    "    reader = PdfReader(pdf_path)\n",
    "    pages = []\n",
    "\n",
    "    for page_number, page in enumerate(reader.pages, start=1):\n",
    "        text = page.extract_text() or \"\"\n",
    "        pages.append({\n",
    "            \"page\": page_number,\n",
    "            \"text\": text\n",
    "        })\n",
    "\n",
    "    return pages\n",
    "\n",
    "\n",
    "pages = extract_pdf_text(PDF_PATH)\n",
    "\n",
    "print(\"=\" * 60)\n",
    "print(\"[1/7] PDF EXTRACTION\")\n",
    "print(\"=\" * 60)\n",
    "print(f\"✓ Pages extracted : {len(pages)}\")\n",
    "print(f\"✓ Characters      : {sum(len(p['text']) for p in pages):,}\")\n"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 6. Light Text Cleaning Module"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 6,
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "============================================================\n",
      "[2/7] TEXT CLEANING\n",
      "============================================================\n",
      "✓ Light cleaning completed.\n",
      "✓ Removed unnecessary whitespace and formatting noise.\n"
     ]
    }
   ],
   "source": [
    "# =========================\n",
    "# 6. TEXT CLEANING\n",
    "# =========================\n",
    "\n",
    "def clean_text(text):\n",
    "    text = text.replace(\"\\x00\", \" \")\n",
    "    text = re.sub(r\"[ \\t]+\", \" \", text)\n",
    "    text = re.sub(r\"\\n{3,}\", \"\\n\\n\", text)\n",
    "    return text.strip()\n",
    "\n",
    "\n",
    "for page in pages:\n",
    "    page[\"text\"] = clean_text(page[\"text\"])\n",
    "\n",
    "print(\"=\" * 60)\n",
    "print(\"[2/7] TEXT CLEANING\")\n",
    "print(\"=\" * 60)\n",
    "print(\"✓ Light cleaning completed.\")\n",
    "print(\"✓ Removed unnecessary whitespace and formatting noise.\")\n"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 7. Text Chunking Module"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 10,
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "============================================================\n",
      "[3/7] TEXT CHUNKING\n",
      "============================================================\n",
      "✓ Chunks created : 10\n",
      "✓ Chunk overlap  : 100 words\n"
     ]
    }
   ],
   "source": [
    "# =========================\n",
    "# 7. TEXT CHUNKING\n",
    "# =========================\n",
    "\n",
    "def create_chunks(pages, chunk_words=900, overlap_words=100):\n",
    "    words = []\n",
    "    page_numbers = []\n",
    "\n",
    "    for page in pages:\n",
    "        page_words = page[\"text\"].split()\n",
    "        words.extend(page_words)\n",
    "        page_numbers.extend([page[\"page\"]] * len(page_words))\n",
    "\n",
    "    if not words:\n",
    "        raise ValueError(\"No extractable text was found in the PDF.\")\n",
    "\n",
    "    chunks = []\n",
    "    start = 0\n",
    "    chunk_id = 1\n",
    "\n",
    "    while start < len(words):\n",
    "        end = min(start + chunk_words, len(words))\n",
    "\n",
    "        chunks.append({\n",
    "            \"chunk_id\": chunk_id,\n",
    "            \"text\": \" \".join(words[start:end]),\n",
    "            \"pages\": sorted(set(page_numbers[start:end]))\n",
    "        })\n",
    "\n",
    "        if end == len(words):\n",
    "            break\n",
    "\n",
    "        start = max(end - overlap_words, start + 1)\n",
    "        chunk_id += 1\n",
    "\n",
    "    return chunks\n",
    "\n",
    "\n",
    "chunks = create_chunks(\n",
    "    pages,\n",
    "    chunk_words=CHUNK_WORDS,\n",
    "    overlap_words=CHUNK_OVERLAP\n",
    ")\n",
    "\n",
    "print(\"=\" * 60)\n",
    "print(\"[3/7] TEXT CHUNKING\")\n",
    "print(\"=\" * 60)\n",
    "print(f\"✓ Chunks created : {len(chunks)}\")\n",
    "print(f\"✓ Chunk overlap  : {CHUNK_OVERLAP} words\")\n"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 8. QA Schema + Prompt Module"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 8,
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "✓ QA schema and generation prompt ready.\n"
     ]
    }
   ],
   "source": [
    "# =========================\n",
    "# 8. QA SCHEMA + PROMPT\n",
    "# =========================\n",
    "\n",
    "class QAPair(BaseModel):\n",
    "    question: str = Field(min_length=5)\n",
    "    answer: str = Field(min_length=5)\n",
    "\n",
    "\n",
    "class QADataset(BaseModel):\n",
    "    qa_pairs: List[QAPair]\n",
    "\n",
    "\n",
    "def build_prompt(context, number_of_pairs):\n",
    "    return f\"\"\"\n",
    "You are an expert technical QA dataset generator for Oil and Gas documentation.\n",
    "\n",
    "Generate exactly {number_of_pairs} high-quality question-answer pairs from ONLY the supplied context.\n",
    "\n",
    "Rules:\n",
    "1. Use only information present in the supplied context.\n",
    "2. Do not invent facts or use outside knowledge.\n",
    "3. Questions must be meaningful and specific to the technical content.\n",
    "4. Answers must be accurate, complete, and supported by the context.\n",
    "5. Avoid duplicate or nearly duplicate questions.\n",
    "6. Cover different concepts from the context when possible.\n",
    "7. Do not mention that you are an AI.\n",
    "8. Return JSON only in this structure:\n",
    "{{\n",
    "  \"qa_pairs\": [\n",
    "    {{\n",
    "      \"question\": \"Question here\",\n",
    "      \"answer\": \"Answer here\"\n",
    "    }}\n",
    "  ]\n",
    "}}\n",
    "\n",
    "DOCUMENT CONTEXT:\n",
    "{context}\n",
    "\"\"\"\n",
    "\n",
    "\n",
    "def generate_qa_pairs(context, number_of_pairs):\n",
    "    prompt = build_prompt(context, number_of_pairs)\n",
    "\n",
    "    response = client.chat.completions.create(\n",
    "        model=GROQ_MODEL,\n",
    "        messages=[\n",
    "            {\n",
    "                \"role\": \"system\",\n",
    "                \"content\": \"You generate grounded Oil and Gas technical QA datasets.\"\n",
    "            },\n",
    "            {\n",
    "                \"role\": \"user\",\n",
    "                \"content\": prompt\n",
    "            }\n",
    "        ],\n",
    "        response_format={\"type\": \"json_object\"},\n",
    "        temperature=0.2\n",
    "    )\n",
    "\n",
    "    content = response.choices[0].message.content\n",
    "    data = json.loads(content)\n",
    "\n",
    "    return QADataset.model_validate(data).qa_pairs\n",
    "\n",
    "\n",
    "print(\"✓ QA schema and generation prompt ready.\")\n"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 9. Validation & Duplicate Removal Module"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 11,
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "✓ Validation module ready.\n"
     ]
    }
   ],
   "source": [
    "# =========================\n",
    "# 9. VALIDATION\n",
    "# =========================\n",
    "\n",
    "def normalize_question(question):\n",
    "    question = question.lower().strip()\n",
    "    question = re.sub(r\"[^a-z0-9 ]\", \"\", question)\n",
    "    question = re.sub(r\"\\s+\", \" \", question)\n",
    "    return question\n",
    "\n",
    "\n",
    "def add_unique_pairs(all_pairs, new_pairs, seen_questions):\n",
    "    added = 0\n",
    "\n",
    "    for pair in new_pairs:\n",
    "        question = pair.question.strip()\n",
    "        answer = pair.answer.strip()\n",
    "\n",
    "        if not question or not answer:\n",
    "            continue\n",
    "\n",
    "        key = normalize_question(question)\n",
    "\n",
    "        if key in seen_questions:\n",
    "            continue\n",
    "\n",
    "        seen_questions.add(key)\n",
    "        all_pairs.append(pair)\n",
    "        added += 1\n",
    "\n",
    "    return added\n",
    "\n",
    "\n",
    "print(\"✓ Validation module ready.\")\n"
   ]
  },
