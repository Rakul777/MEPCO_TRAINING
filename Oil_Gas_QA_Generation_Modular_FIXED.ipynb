   "source": [
    "# =========================\n",
    "# 11. FINE-TUNING FORMAT\n",
    "# =========================\n",
    "\n",
    "def format_for_finetuning(qa_pairs, source_document):\n",
    "    rows = []\n",
    "\n",
    "    for idx, pair in enumerate(qa_pairs, start=1):\n",
    "        rows.append({\n",
    "            \"messages\": [\n",
    "                {\n",
    "                    \"role\": \"system\",\n",
    "                    \"content\": (\n",
    "                        \"You are a helpful assistant specialized in \"\n",
    "                        \"Oil and Gas technical documentation.\"\n",
    "                    )\n",
    "                },\n",
    "                {\n",
    "                    \"role\": \"user\",\n",
    "                    \"content\": pair.question\n",
    "                },\n",
    "                {\n",
    "                    \"role\": \"assistant\",\n",
    "                    \"content\": pair.answer\n",
    "                }\n",
    "            ],\n",
    "            \"metadata\": {\n",
    "                \"id\": idx,\n",
    "                \"source_document\": Path(source_document).name,\n",
    "                \"generation_model\": GROQ_MODEL\n",
    "            }\n",
    "        })\n",
    "\n",
    "    return rows\n",
    "\n",
    "\n",
    "formatted_dataset = format_for_finetuning(\n",
    "    all_pairs,\n",
    "    PDF_PATH\n",
    ")\n",
    "\n",
    "print(\"=\" * 60)\n",
    "print(\"[5/7] DATASET FORMATTING\")\n",
    "print(\"=\" * 60)\n",
    "print(f\"✓ Fine-tuning records created : {len(formatted_dataset)}\")\n"
   ]
  },
