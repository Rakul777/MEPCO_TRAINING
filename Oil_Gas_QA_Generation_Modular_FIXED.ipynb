    "# ============================================\n",
    "# CONTINUE QA GENERATION UNTIL 250\n",
    "# ============================================\n",
    "\n",
    "additional_requests = 0\n",
    "MAX_ADDITIONAL_REQUESTS = 10\n",
    "\n",
    "print(\"=\" * 60)\n",
    "print(\"CONTINUING QA GENERATION\")\n",
    "print(\"=\" * 60)\n",
    "print(f\"Current QA : {len(all_pairs)}\")\n",
    "print(f\"Target QA  : {TARGET_PAIRS}\")\n",
    "\n",
    "while len(all_pairs) < TARGET_PAIRS and additional_requests < MAX_ADDITIONAL_REQUESTS:\n",
    "\n",
    "    for chunk in chunks:\n",
    "\n",
    "        if len(all_pairs) >= TARGET_PAIRS:\n",
    "            break\n",
    "\n",
    "        remaining = TARGET_PAIRS - len(all_pairs)\n",
    "        request_pairs = min(PAIRS_PER_REQUEST, remaining)\n",
    "\n",
    "        print(\n",
    "            f\"\\nAdditional Request {additional_requests + 1} \"\n",
    "            f\"| Chunk {chunk['chunk_id']} \"\n",
    "            f\"| Requesting {request_pairs} QA\"\n",
    "        )\n",
    "\n",
    "        try:\n",
    "            generated = generate_qa_pairs(\n",
    "                chunk[\"text\"],\n",
    "                request_pairs\n",
    "            )\n",
    "\n",
    "            added = add_unique_pairs(\n",
    "                all_pairs,\n",
    "                generated,\n",
    "                seen_questions\n",
    "            )\n",
    "\n",
    "            additional_requests += 1\n",
    "\n",
    "            print(f\"Generated     : {len(generated)}\")\n",
    "            print(f\"Unique added  : {added}\")\n",
    "            print(f\"Total unique QA : {len(all_pairs)}/{TARGET_PAIRS}\")\n",
    "\n",
    "        except Exception as e:\n",
    "            additional_requests += 1\n",
    "            print(f\"⚠ Generation error: {type(e).__name__}: {e}\")\n",
    "\n",
    "        if len(all_pairs) >= TARGET_PAIRS:\n",
    "            break\n",
    "\n",
    "        time.sleep(SLEEP_SECONDS)\n",
    "\n",
    "print(\"\\n\" + \"=\" * 60)\n",
    "print(\"CONTINUATION FINISHED\")\n",
    "print(\"=\" * 60)\n",
    "print(f\"Total unique QA pairs : {len(all_pairs)}\")"
