    "# =========================\n",
    "# 10. MAIN QA GENERATION\n",
    "# =========================\n",
    "\n",
    "all_pairs = []\n",
    "seen_questions = set()\n",
    "requests_used = 0\n",
    "\n",
    "print(\"=\" * 60)\n",
    "print(\"[4/7] QA GENERATION STARTED\")\n",
    "print(\"=\" * 60)\n",
    "\n",
    "for chunk in chunks:\n",
    "\n",
    "    if len(all_pairs) >= TARGET_PAIRS:\n",
    "        break\n",
    "\n",
    "    if requests_used >= MAX_REQUESTS:\n",
    "        print(\"⚠ Maximum request limit reached.\")\n",
    "        break\n",
    "\n",
    "    remaining = TARGET_PAIRS - len(all_pairs)\n",
    "    request_pairs = min(PAIRS_PER_REQUEST, remaining)\n",
    "\n",
    "    print(\n",
    "        f\"\\nChunk {chunk['chunk_id']} | \"\n",
    "        f\"Pages {chunk['pages']} | \"\n",
    "        f\"Requesting {request_pairs} QA\"\n",
    "    )\n",
    "\n",
    "    try:\n",
    "        generated = generate_qa_pairs(\n",
    "            chunk[\"text\"],\n",
    "            request_pairs\n",
    "        )\n",
    "\n",
    "        added = add_unique_pairs(\n",
    "            all_pairs,\n",
    "            generated,\n",
    "            seen_questions\n",
    "        )\n",
    "\n",
    "        requests_used += 1\n",
    "\n",
    "        print(f\"✓ Generated : {len(generated)}\")\n",
    "        print(f\"✓ Unique added : {added}\")\n",
    "        print(f\"✓ Total unique QA : {len(all_pairs)}/{TARGET_PAIRS}\")\n",
    "\n",
    "    except Exception as e:\n",
    "        requests_used += 1\n",
    "        print(f\"⚠ Chunk failed: {type(e).__name__}: {e}\")\n",
    "\n",
    "    time.sleep(SLEEP_SECONDS)\n",
    "\n",
    "\n",
    "print(\"\\n\" + \"=\" * 60)\n",
    "print(\"QA GENERATION FINISHED\")\n",
    "print(\"=\" * 60)\n",
    "print(f\"Total unique QA pairs : {len(all_pairs)}\")\n",
    "print(f\"Requests used         : {requests_used}\")\n"
   ]
